# Agent skill environment configuration.
# Keep real secrets in a local .env file or user environment variables.
# Do not commit real API keys.

# OpenRouter
# Used by generate-image, scientific-schematics, and optional research-lookup synthesis.
OPENROUTER_API_KEY=

# Direct image provider placeholders
# Used when a direct provider is selected in the image-generation CLI.
# OpenRouter remains the default backend for the repository's image scripts.
GEMINI_API_KEY=
OPENAI_API_KEY=

# MCP auth placeholders
# Used by Codex MCP servers when connecting to hosted services.
GITHUB_PERSONAL_ACCESS_TOKEN=
HF_TOKEN=

# Semantic Scholar
# Optional for research-lookup; helps reduce rate-limit issues for Semantic Scholar lookups.
SEMANTIC_SCHOLAR_API_KEY=

# Parallel
# Optional for research-lookup web/context fallback when configured.
PARALLEL_API_KEY=

# NCBI / PubMed
# Optional for citation-management PubMed searches.
NCBI_API_KEY=
NCBI_EMAIL=

# Zotero local API
# Optional override for the local Zotero connector endpoint.
ZOTERO_LOCAL_BASE_URL=http://127.0.0.1:23119
