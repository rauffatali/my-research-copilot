% BibTeX Template for AI/ML/CV Research Projects
%
% Purpose:
%   Provide clean example entries for common reference types used in AI,
%   machine learning, computer vision, datasets, software, benchmarks, and
%   technical documentation.
%
% Notes:
%   - These are examples/templates, not required references.
%   - Verify every real reference before manuscript use.
%   - Protect acronyms, model names, dataset names, and proper nouns with braces.
%   - Prefer DOI, arXiv ID, official URL, or publisher URL when available.
%   - Do not label preprints as peer-reviewed papers unless a published version
%     has been verified.
%
% Common protected terms:
%   {YOLO}, {CNN}, {R-CNN}, {Faster R-CNN}, {ViT}, {DETR}, {CLIP}, {COCO},
%   {ImageNet}, {Cityscapes}, {BDD100K}, {mAP}, {IoU}, {AP50}, {AP75}


% =============================================================================
% JOURNAL ARTICLE
% =============================================================================
%
% Use @article for peer-reviewed journal papers.
% Required fields commonly include: author, title, journal, year.
% Prefer DOI when available.

@article{example2025journal,
  author  = {Author, Alice and Researcher, Bob and Scientist, Carol},
  title   = {A Verified Journal Article Title with Protected {AI} and {CV} Terms},
  journal = {Journal Name},
  year    = {2025},
  volume  = {12},
  number  = {3},
  pages   = {100--120},
  doi     = {10.0000/example.doi}
}


% =============================================================================
% CONFERENCE PAPER
% =============================================================================
%
% Use @inproceedings for conference papers.
% For AI/CV, this is common for CVPR, ICCV, ECCV, WACV, NeurIPS, ICML, ICLR, etc.

@inproceedings{example2024conference,
  author    = {Author, Alice and Researcher, Bob},
  title     = {A Conference Paper on {YOLO}-Based Object Detection},
  booktitle = {Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year      = {2024},
  pages     = {1--10},
  doi       = {10.0000/example.conference}
}


% =============================================================================
% ARXIV PREPRINT
% =============================================================================
%
% Use @misc for arXiv preprints unless your venue/template prefers @article.
% Do not describe as peer-reviewed unless a peer-reviewed version is verified.

@misc{example2025arxiv,
  author        = {Author, Alice and Researcher, Bob},
  title         = {A Recent Preprint on Vision Foundation Models},
  year          = {2025},
  eprint        = {2501.00001},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CV},
  url           = {https://arxiv.org/abs/2501.00001},
  note          = {arXiv preprint}
}


% =============================================================================
% DATASET PAPER
% =============================================================================
%
% Use the official dataset paper when available.
% Include DOI or official URL when available.
% Dataset names often need protected capitalization.

@inproceedings{example2014dataset,
  author    = {Dataset, Dana and Annotator, Evan and Curator, Frank},
  title     = {{ExampleSet}: A Large-Scale Dataset for Visual Recognition},
  booktitle = {Proceedings of the European Conference on Computer Vision (ECCV)},
  year      = {2014},
  pages     = {1--15},
  doi       = {10.0000/example.dataset}
}


% =============================================================================
% DATASET WITHOUT FORMAL PAPER
% =============================================================================
%
% Use @misc when the dataset has no formal paper.
% Include version and access date when relevant.

@misc{example2024datasetPage,
  author       = {{Example Dataset Team}},
  title        = {{ExampleDataset}: Example Dataset and Benchmark},
  year         = {2024},
  url          = {https://example.org/datasets/example-dataset},
  note         = {Dataset, version 1.0. Accessed 2026-05-22}
}


% =============================================================================
% SOFTWARE / CODE REPOSITORY
% =============================================================================
%
% Cite software only when the claim concerns implementation, availability,
% tooling, or reproducibility. Prefer a paper if the claim is scientific.

@software{example2024software,
  author  = {{Example AI Lab}},
  title   = {{ExampleDetect}: Object Detection Training Code},
  year    = {2024},
  version = {1.2.0},
  url     = {https://github.com/example/example-detect},
  note    = {Software repository. Accessed 2026-05-22}
}


% =============================================================================
% MODEL CARD / MODEL RELEASE
% =============================================================================
%
% Use for released models, model cards, or official model pages.
% Include version/date when available.

@misc{example2025modelCard,
  author = {{Example Model Team}},
  title  = {{ExampleVision-L}: Model Card and Release Notes},
  year   = {2025},
  url    = {https://example.org/models/examplevision-l},
  note   = {Model card. Accessed 2026-05-22}
}


% =============================================================================
% BENCHMARK OR LEADERBOARD PAGE
% =============================================================================
%
% Dynamic benchmark pages should include access date.
% Do not cite a leaderboard as if it were a peer-reviewed paper.

@misc{example2025benchmark,
  author = {{Example Benchmark Maintainers}},
  title  = {{Example Detection Benchmark} Leaderboard},
  year   = {2025},
  url    = {https://example.org/benchmark},
  note   = {Benchmark leaderboard. Accessed 2026-05-22}
}


% =============================================================================
% TECHNICAL REPORT
% =============================================================================
%
% Use for institution or company technical reports.

@techreport{example2024techreport,
  author      = {Author, Alice and Engineer, Bob},
  title       = {Technical Report on Scalable Vision Model Evaluation},
  institution = {Example Research Institute},
  year        = {2024},
  number      = {ERI-TR-2024-01},
  url         = {https://example.org/reports/eri-tr-2024-01}
}


% =============================================================================
% WEBPAGE / DOCUMENTATION
% =============================================================================
%
% Use sparingly. Prefer official documentation or release pages.
% Include access date for changing pages.

@misc{example2026docs,
  author = {{Example Library Developers}},
  title  = {{ExampleCV} Documentation: Evaluation Metrics},
  year   = {2026},
  url    = {https://examplecv.org/docs/metrics},
  note   = {Documentation. Accessed 2026-05-22}
}


% =============================================================================
% BOOK
% =============================================================================
%
% Use @book for textbooks or monographs.

@book{example2022book,
  author    = {Author, Alice and Researcher, Bob},
  title     = {Machine Learning for Visual Recognition},
  publisher = {Example Press},
  year      = {2022},
  address   = {New York, NY},
  isbn      = {978-0-000-00000-0}
}


% =============================================================================
% BOOK CHAPTER / EDITED VOLUME CHAPTER
% =============================================================================

@incollection{example2023chapter,
  author    = {Author, Alice},
  title     = {Evaluation Protocols for Computer Vision Systems},
  booktitle = {Handbook of Machine Learning Evaluation},
  editor    = {Editor, Erin and Curator, Chris},
  publisher = {Example Press},
  year      = {2023},
  pages     = {25--50},
  doi       = {10.0000/example.chapter}
}


% =============================================================================
% THESIS / DISSERTATION
% =============================================================================

@phdthesis{example2024thesis,
  author = {Researcher, Riley},
  title  = {Robust Computer Vision under Domain Shift},
  school = {Example University},
  year   = {2024},
  url    = {https://example.edu/theses/researcher2024}
}


% =============================================================================
% STANDARD / SPECIFICATION
% =============================================================================

@misc{example2023standard,
  author = {{Example Standards Organization}},
  title  = {Standard Specification for Dataset Documentation},
  year   = {2023},
  url    = {https://example.org/standards/dataset-documentation},
  note   = {Standard. Accessed 2026-05-22}
}


